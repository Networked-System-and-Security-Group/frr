# FITI simulation environment defaults, loaded by every deployment tool.
# A value already exported in the caller's environment wins; a value set in a
# node's node-configs/<name>.env wins on that node.

# Interface carrying the MIDR transport-address and the underlay default route.
MIDR_UNDERLAY_INTERFACE=${MIDR_UNDERLAY_INTERFACE:-ens5}
# Netplan files owned by the platform (out-of-band management and the L3
# underlay).  The installer refuses to run without them and verifies they are
# byte-for-byte unchanged after deployment.
MIDR_PROTECTED_NETPLAN=${MIDR_PROTECTED_NETPLAN:-"60-ens4.yaml 61-l3.yaml"}
# The nodes are reached through the platform NAT; no jump host is needed from
# the FITI management server.  From elsewhere set, for example:
#   MIDR_SSH_EXTRA="-o ProxyJump=user@management-host"
MIDR_SSH_EXTRA=${MIDR_SSH_EXTRA:-}
